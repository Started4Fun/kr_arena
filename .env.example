# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# Discord Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=

# 선택 사항: 지정하면 길드 명령어로 즉시 등록됩니다. 비워두면 전역 명령어로 등록됩니다.
DISCORD_GUILD_ID=

# Riot Developer Portal의 Development API Key
RIOT_API_KEY=

# Match-v5와 Account-v1은 한국 서버 계정에 대해 ASIA 지역 라우팅을 사용합니다.
RIOT_REGION=asia
RIOT_REQUEST_DELAY_MS=100

# 한 계정에서 한 번에 조회할 최대 경기 수(1~100)
MAX_MATCHES_PER_PLAYER=20

# 봇이 저장할 데이터 파일
DATA_FILE=./data/state.json
